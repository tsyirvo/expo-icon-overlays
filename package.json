{
  "name": "expo-icon-overlays",
  "version": "0.1.1",
  "description": "Text overlays for Expo app icons at prebuild time",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsyirvo/expo-icon-overlays.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/",
    "app.plugin.js",
    "assets/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:fixtures": "bun run build && cd fixtures/expo-app && bun install --frozen-lockfile && cd ../.. && bun scripts/check-fixtures.ts",
    "check:package": "bun run build && sh scripts/check-package.sh",
    "check:sdk": "sh scripts/check-sdk.sh",
    "dev": "tsdown --watch",
    "format": "biome format --write --files-ignore-unknown=true .",
    "format:check": "biome format --files-ignore-unknown=true .",
    "hooks:check": "mise exec -- hk check --all",
    "hooks:fix": "mise exec -- hk fix --all",
    "hooks:install": "mise exec -- hk install --mise",
    "knip": "knip",
    "lint": "biome check --write --files-ignore-unknown=true .",
    "lint:ci": "biome ci --files-ignore-unknown=true .",
    "lint:ts": "tsc --noEmit",
    "preview": "bun scripts/preview.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "pngjs": "7.0.0",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/fontkit": "2.0.8",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/semver": "7.7.1",
    "expo": "58.0.22",
    "fontkit": "2.0.4",
    "knip": "6.43.0",
    "pixelmatch": "7.1.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "ultracite": "8.1.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "expo": "^58.0.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
